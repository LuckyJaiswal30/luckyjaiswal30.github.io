# dependencies. This repo uses npm; other lockfiles mean someone ran the
# wrong package manager, so they are ignored rather than committed.
/node_modules
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock
bun.lock
bun.lockb

# next.js and build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing
/coverage

# env files. The example carries no secrets and documents what to set, so it
# is deliberately tracked.
.env*
!.env.example

# vercel
.vercel

# logs
*.log

# editors and OS
.DS_Store
.vscode/
.idea/

# local AI tooling
.claude/
AGENTS.md
CLAUDE.md

# certificates
*.pem
